<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified"
  vc:minVersion="1.1">

  <xs:include schemaLocation="hevc_common.xsd"/>

  <xs:element name="HEVCBitstream">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="NALUnit" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="uri" type="xs:anyURI"/>

      <!-- SDR HD Colour Space (BT.709) per clause 4.4.3.2 -->

      <!-- colour_primaries = 1 (BT.709) -->
      <xs:assert test="exists(NALUnit[nuh_layer_id=0]/SequenceParameterSet/colour_primaries)"/>
      <xs:assert test="NALUnit[nuh_layer_id=0]/SequenceParameterSet/colour_primaries = 1"/>

      <!-- transfer_characteristics = 1 (BT.709) -->
      <xs:assert test="exists(NALUnit[nuh_layer_id=0]/SequenceParameterSet/transfer_characteristics)"/>
      <xs:assert test="NALUnit[nuh_layer_id=0]/SequenceParameterSet/transfer_characteristics = 1"/>

      <!-- matrix_coeffs = 1 (BT.709 NCL YCbCr) -->
      <xs:assert test="exists(NALUnit[nuh_layer_id=0]/SequenceParameterSet/matrix_coeffs)"/>
      <xs:assert test="NALUnit[nuh_layer_id=0]/SequenceParameterSet/matrix_coeffs = 1"/>

      <!-- chroma_sample_loc_type_top_field = 0 (horizontally co-sited, vertically centered) -->
      <xs:assert test="exists(NALUnit[nuh_layer_id=0]/SequenceParameterSet/chroma_sample_loc_type_top_field)"/>
      <xs:assert test="NALUnit[nuh_layer_id=0]/SequenceParameterSet/chroma_sample_loc_type_top_field = 0"/>

    </xs:complexType>
  </xs:element>

</xs:schema>
