<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
  elementFormDefault="qualified"
  attributeFormDefault="unqualified"
  vc:minVersion="1.1">

  <xs:include schemaLocation="hevc_common.xsd"/>

  <xs:element name="HEVCBitstream">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="NALUnit" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="uri" type="xs:anyURI"/>

      <!-- Base layer: Main 10 profile conformance -->
      <xs:assert test="exists(NALUnit[nuh_layer_id=0]/SequenceParameterSet/general_profile_idc)"/>
      <xs:assert test="NALUnit[nuh_layer_id=0]/SequenceParameterSet/general_profile_idc = 2 or
                       (exists(NALUnit[nuh_layer_id=0]/SequenceParameterSet/general_profile_compatibility_flag[@i=2]) and
                        string(NALUnit[nuh_layer_id=0]/SequenceParameterSet/general_profile_compatibility_flag[@i=2]) = '1')"/>

      <!-- Base layer: Main Tier, Level 5.1 -->
      <xs:assert test="string(NALUnit[nuh_layer_id=0]/SequenceParameterSet/general_tier_flag) = '0'"/>
      <xs:assert test="NALUnit[nuh_layer_id=0]/SequenceParameterSet/general_level_idc = 51"/>

      <!-- At least one enhancement layer exists -->
      <xs:assert test="count(NALUnit[nuh_layer_id != 0]) >= 1"/>

      <!-- Enhancement layer: Multiview Main 10 profile conformance -->
      <xs:assert test="exists(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_profile_idc)"/>
      <xs:assert test="NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_profile_idc = 6 or
                       (exists(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_profile_compatibility_flag[@j=6]) and
                        string(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_profile_compatibility_flag[@j=6]) = '1')"/>

      <!-- Enhancement layer: Multiview Main 10 constraint flags -->
      <xs:assert test="string(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_max_12bit_constraint_flag) = '1'"/>
      <xs:assert test="string(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_max_10bit_constraint_flag) = '1'"/>
      <xs:assert test="string(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_max_8bit_constraint_flag) = '1'"/>
      <xs:assert test="string(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_max_422chroma_constraint_flag) = '1'"/>
      <xs:assert test="string(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_max_420chroma_constraint_flag) = '1'"/>
      <xs:assert test="string(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_max_monochrome_constraint_flag) = '0'"/>
      <xs:assert test="string(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_intra_constraint_flag) = '0'"/>
      <xs:assert test="string(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_one_picture_only_constraint_flag) = '0'"/>
      <xs:assert test="string(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_lower_bit_rate_constraint_flag) = '1'"/>

      <!-- Enhancement layer: Main Tier, Level 5.1 -->
      <xs:assert test="string(NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_tier_flag) = '0'"/>
      <xs:assert test="NALUnit[nuh_layer_id=0]/VideoParameterSet/profile_tier_level[@i=1]/general_level_idc = 51"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
