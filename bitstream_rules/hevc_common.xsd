<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
           elementFormDefault="qualified"
           vc:minVersion="1.1">

  <!-- Group definitions -->
  <!-- VuiParameters definition -->
  <xs:group name="VuiParametersStructure">
    <xs:sequence>
      <xs:element name="aspect_ratio_info_present_flag" type="xs:boolean"/>

      <!-- if aspect_ratio_info_present_flag -->
      <xs:sequence minOccurs="0">
        <xs:element name="aspect_ratio_idc" type="xs:integer"/>
        <xs:sequence minOccurs="0">
          <xs:element name="sar_width" type="xs:integer"/>
          <xs:element name="sar_height" type="xs:integer"/>
        </xs:sequence>
      </xs:sequence>

      <xs:element name="overscan_info_present_flag" type="xs:boolean"/>
      <xs:element name="overscan_appropriate_flag" type="xs:boolean" minOccurs="0"/>
      <xs:element name="video_signal_type_present_flag" type="xs:boolean"/>

      <!-- if video_signal_type_present_flag -->
      <xs:sequence minOccurs="0">
        <xs:element name="video_format" type="xs:integer"/>
        <xs:element name="video_full_range_flag" type="xs:boolean"/>
        <xs:element name="colour_description_present_flag" type="xs:boolean"/>

        <!-- if colour_description_present_flag -->
        <xs:sequence minOccurs="0">
          <xs:element name="colour_primaries" type="xs:integer"/>
          <xs:element name="transfer_characteristics" type="xs:integer"/>
          <xs:element name="matrix_coeffs" type="xs:integer"/>
        </xs:sequence>
      </xs:sequence>

      <xs:element name="chroma_loc_info_present_flag" type="xs:boolean"/>

      <!-- if chroma_loc_info_present_flag -->
      <xs:sequence minOccurs="0">
        <xs:element name="chroma_sample_loc_type_top_field" type="xs:integer"/>
        <xs:element name="chroma_sample_loc_type_bottom_field" type="xs:integer"/>
      </xs:sequence>

      <xs:element name="neutral_chroma_indication_flag" type="xs:boolean"/>
      <xs:element name="field_seq_flag" type="xs:boolean"/>
      <xs:element name="frame_field_info_present_flag" type="xs:boolean"/>
      <xs:element name="default_display_window_flag" type="xs:boolean"/>

      <!-- if default_display_window_flag -->
      <xs:sequence minOccurs="0">
        <xs:element name="def_disp_win_left_offset" type="xs:integer"/>
        <xs:element name="def_disp_win_right_offset" type="xs:integer"/>
        <xs:element name="def_disp_win_top_offset" type="xs:integer"/>
        <xs:element name="def_disp_win_bottom_offset" type="xs:integer"/>
      </xs:sequence>

      <xs:element name="vui_timing_info_present_flag" type="xs:boolean"/>

      <!-- if vui_timing_info_present_flag -->
      <xs:sequence minOccurs="0">
        <xs:element name="vui_num_units_in_tick" type="xs:integer"/>
        <xs:element name="vui_time_scale" type="xs:integer"/>
        <xs:element name="vui_poc_proportional_to_timing_flag" type="xs:boolean"/>
        <xs:element name="vui_num_ticks_poc_diff_one_minus1" type="xs:integer" minOccurs="0"/>
        <xs:element name="vui_hrd_parameters_present_flag" type="xs:boolean"/>

        <!-- if vui_hrd_parameters_present_flag -->
        <xs:element name="vui_hrd_parameters" type="HRDParametersType" minOccurs="0"/>
      </xs:sequence>

      <xs:element name="bitstream_restriction_flag" type="xs:boolean"/>

      <!-- if bitstream_restriction_flag -->
      <xs:sequence minOccurs="0">
        <xs:element name="tiles_fixed_structure_flag" type="xs:boolean"/>
        <xs:element name="motion_vectors_over_pic_boundaries_flag" type="xs:boolean"/>
        <xs:element name="restricted_ref_pic_lists_flag" type="xs:boolean"/>
        <xs:element name="min_spatial_segmentation_idc" type="xs:integer"/>
        <xs:element name="max_bytes_per_pic_denom" type="xs:integer"/>
        <xs:element name="max_bits_per_min_cu_denom" type="xs:integer"/>
        <xs:element name="log2_max_mv_length_horizontal" type="xs:integer"/>
        <xs:element name="log2_max_mv_length_vertical" type="xs:integer"/>
      </xs:sequence>
    </xs:sequence>
  </xs:group>

  <!-- ProfileTierLevelType definition -->
  <xs:complexType name="ProfileTierLevelType">
    <xs:sequence>
      <xs:group ref="ProfileTierLevelStructure" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="i" type="xs:nonNegativeInteger" use="required"/>
  </xs:complexType>

  <!-- ProfileTierLevel definition -->
  <xs:group name="ProfileTierLevelStructure">
    <xs:choice>
      <!-- Full profile tier level structure -->
      <xs:sequence>
        <xs:element name="general_profile_space" type="xs:integer"/>
        <xs:element name="general_tier_flag" type="xs:boolean"/>
        <xs:element name="general_profile_idc" type="xs:integer"/>
        <xs:element name="general_profile_compatibility_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="general_progressive_source_flag" type="xs:boolean"/>
        <xs:element name="general_interlaced_source_flag" type="xs:boolean"/>
        <xs:element name="general_non_packed_constraint_flag" type="xs:boolean"/>
        <xs:element name="general_frame_only_constraint_flag" type="xs:boolean"/>
        <xs:choice>
          <xs:sequence>
            <xs:element name="general_max_12bit_constraint_flag" type="xs:boolean"/>
            <xs:element name="general_max_10bit_constraint_flag" type="xs:boolean"/>
            <xs:element name="general_max_8bit_constraint_flag" type="xs:boolean"/>
            <xs:element name="general_max_422chroma_constraint_flag" type="xs:boolean"/>
            <xs:element name="general_max_420chroma_constraint_flag" type="xs:boolean"/>
            <xs:element name="general_max_monochrome_constraint_flag" type="xs:boolean"/>
            <xs:element name="general_intra_constraint_flag" type="xs:boolean"/>
            <xs:element name="general_one_picture_only_constraint_flag" type="xs:boolean"/>
            <xs:element name="general_lower_bit_rate_constraint_flag" type="xs:boolean"/>
            <xs:choice>
              <xs:sequence>
                <xs:element name="general_max_14bit_constraint_flag" type="xs:boolean"/>
                <xs:element name="general_reserved_zero_33bits" type="xs:integer"/>
              </xs:sequence>
              <xs:sequence>
                <xs:element name="general_reserved_zero_34bits" type="xs:integer"/>
             </xs:sequence>
            </xs:choice>
          </xs:sequence>
          <xs:sequence>
            <xs:element name="general_reserved_zero_7bits" type="xs:integer"/>
            <xs:element name="general_one_picture_only_constraint_flag" type="xs:boolean"/>
            <xs:element name="general_reserved_zero_35bits" type="xs:integer"/>
          </xs:sequence>
          <xs:sequence>
            <xs:element name="general_reserved_zero_43bits" type="xs:integer"/>
          </xs:sequence>
        </xs:choice>

        <xs:choice>
          <xs:sequence>
            <xs:element name="general_inbld_flag" type="xs:boolean"/>
          </xs:sequence>
          <xs:sequence>
            <xs:element name="general_reserved_zero_bit" type="xs:boolean"/>
          </xs:sequence>
        </xs:choice>

        <xs:element name="general_level_idc" type="xs:integer" minOccurs="1" maxOccurs="1"/>

        <!-- Sub-layer presence flags -->
        <xs:sequence minOccurs="0">
          <xs:element name="sub_layer_profile_present_flag" type="IndexedBooleanType" minOccurs="1" maxOccurs="1"/>
          <xs:element name="sub_layer_level_present_flag" type="IndexedBooleanType" minOccurs="1" maxOccurs="1"/>
        </xs:sequence>

        <xs:sequence minOccurs="0">
          <xs:element name="reserved_zero_2bits" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>

        <xs:sequence minOccurs="0">
          <!-- Sub-layer profile information -->
          <xs:element name="sub_layer_profile_space" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_tier_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_profile_idc" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_profile_compatibility_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>

          <!-- Sub-layer progressive and interlaced source flags -->
          <xs:element name="sub_layer_progressive_source_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_interlaced_source_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_non_packed_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_frame_only_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>

          <!-- Sub-layer conditional constraint flags -->
          <xs:element name="sub_layer_max_12bit_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_max_10bit_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_max_8bit_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_max_422chroma_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_max_420chroma_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_max_monochrome_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_intra_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_one_picture_only_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_lower_bit_rate_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_max_14bit_constraint_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_reserved_zero_33bits" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_reserved_zero_34bits" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_reserved_zero_35bits" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_reserved_zero_43bits" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>

          <!-- Sub-layer inbld flag -->
          <xs:element name="sub_layer_inbld_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="sub_layer_reserved_zero_bit" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>

          <!-- Sub-layer level information -->
          <xs:element name="sub_layer_level_idc" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:sequence>

      <!-- Level-only profile tier level structure (when profile_present_flag=False) -->
      <xs:sequence>
        <xs:element name="general_level_idc" type="xs:integer"/>
      </xs:sequence>
    </xs:choice>
  </xs:group>

  <!-- StRefPicSet definition -->
  <xs:group name="StRefPicSetStructure">
    <xs:sequence>
      <xs:element name="inter_ref_pic_set_prediction_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="delta_idx_minus1" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:choice>
        <!-- if inter_ref_pic_set_prediction_flag -->
        <xs:sequence>
          <xs:element name="delta_rps_sign" type="IndexedBooleanType" maxOccurs="unbounded"/>
          <xs:element name="abs_delta_rps_minus1" type="IndexedIntegerType" maxOccurs="unbounded"/>
          <xs:sequence minOccurs="0" maxOccurs="unbounded">
            <xs:element name="used_by_curr_pic_flag" type="IndexedBooleanType" maxOccurs="unbounded"/>
            <xs:element name="use_delta_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:sequence>
        <!-- else -->
        <xs:sequence>
          <xs:element name="num_negative_pics" type="IndexedIntegerType" maxOccurs="unbounded"/>
          <xs:element name="num_positive_pics" type="IndexedIntegerType" maxOccurs="unbounded"/>
          <xs:sequence minOccurs="0" maxOccurs="unbounded">
            <xs:element name="delta_poc_s0_minus1" type="IndexedIntegerType" maxOccurs="unbounded"/>
            <xs:element name="used_by_curr_pic_s0_flag" type="IndexedBooleanType" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:sequence minOccurs="0" maxOccurs="unbounded">
            <xs:element name="delta_poc_s1_minus1" type="IndexedIntegerType" maxOccurs="unbounded"/>
            <xs:element name="used_by_curr_pic_s1_flag" type="IndexedBooleanType" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:sequence>
      </xs:choice>
    </xs:sequence>
  </xs:group>

  <xs:group name="SpsMultilayerExtension">
    <xs:sequence>
     <xs:element name="inter_view_mv_vert_constraint_flag" type="xs:boolean"/>
    </xs:sequence>
  </xs:group>

  <xs:group name="SpsSccExtension">
    <xs:sequence>
      <xs:element name="sps_curr_pic_ref_enabled_flag" type="xs:boolean"/>
      <xs:element name="palette_mode_enabled_flag" type="xs:boolean"/>
      <xs:sequence minOccurs="0">
        <xs:element name="palette_max_size" type="xs:integer"/>
        <xs:element name="palette_predictor_initializer_present_flag" type="xs:boolean"/>
        <xs:sequence minOccurs="0">
          <xs:element name="palette_predictor_initializers_num_minus1" type="xs:integer"/>
        </xs:sequence>
      </xs:sequence>
      <xs:element name="motion_vector_resolution_control_idc" type="xs:integer"/>
      <xs:element name="intra_boundary_filtering_disabled_flag" type="xs:boolean"/>
    </xs:sequence>
  </xs:group>

  <xs:group name="SpsRangeExtension">
    <xs:sequence>
      <xs:element name="transform_skip_rotation_enabled_flag" type="xs:boolean"/>
      <xs:element name="transform_skip_context_enabled_flag" type="xs:boolean"/>
      <xs:element name="implicit_rdpcm_enabled_flag" type="xs:boolean"/>
      <xs:element name="explicit_rdpcm_enabled_flag" type="xs:boolean"/>
      <xs:element name="extended_precision_processing_flag" type="xs:boolean"/>
      <xs:element name="intra_smoothing_disabled_flag" type="xs:boolean"/>
      <xs:element name="high_precision_offsets_enabled_flag" type="xs:boolean"/>
      <xs:element name="persistent_rice_adaptation_enabled_flag" type="xs:boolean"/>
      <xs:element name="cabac_bypass_alignment_enabled_flag" type="xs:boolean"/>
    </xs:sequence>
  </xs:group>

  <xs:group name="Sps3DExtension">
    <xs:sequence>
      <xs:element name="iv_di_mc_enabled_flag" type="xs:boolean"/>
      <xs:element name="iv_mv_scal_enabled_flag" type="xs:boolean"/>
      <xs:sequence minOccurs="0">
        <xs:element name="log2_ivmc_sub_pb_size_minus3" type="xs:integer"/>
        <xs:element name="iv_res_pred_enabled_flag" type="xs:boolean"/>
        <xs:element name="depth_ref_enabled_flag" type="xs:boolean"/>
        <xs:element name="vsp_mc_enabled_flag" type="xs:boolean"/>
        <xs:element name="dbbp_enabled_flag" type="xs:boolean"/>
        <xs:sequence minOccurs="0">
          <xs:element name="tex_mc_enabled_flag" type="xs:boolean"/>
          <xs:sequence minOccurs="0">
            <xs:element name="log2_texmc_sub_pb_size_minus3" type="xs:integer"/>
          </xs:sequence>
        </xs:sequence>
        <xs:element name="intra_contour_enabled_flag" type="xs:boolean"/>
        <xs:element name="intra_dc_only_wedge_enabled_flag" type="xs:boolean"/>
        <xs:element name="cqt_cu_part_pred_enabled_flag" type="xs:boolean"/>
        <xs:element name="inter_dc_only_enabled_flag" type="xs:boolean"/>
        <xs:element name="skip_intra_enabled_flag" type="xs:boolean"/>
      </xs:sequence>
    </xs:sequence>
  </xs:group>

  <!-- Type definitions -->
  <!-- HRDParametersType definition -->
  <xs:complexType name="HRDParametersType">
    <xs:sequence>
      <!-- Common HRD parameters -->
      <xs:element name="nal_hrd_parameters_present_flag" type="xs:boolean" minOccurs="0"/>
      <xs:element name="vcl_hrd_parameters_present_flag" type="xs:boolean" minOccurs="0"/>
      <xs:element name="sub_pic_hrd_params_present_flag" type="xs:boolean" minOccurs="0"/>
      <xs:element name="tick_divisor_minus2" type="xs:integer" minOccurs="0"/>
      <xs:element name="du_cpb_removal_delay_increment_length_minus1" type="xs:integer" minOccurs="0"/>
      <xs:element name="sub_pic_cpb_params_in_pic_timing_sei_flag" type="xs:boolean" minOccurs="0"/>
      <xs:element name="dpb_output_delay_du_length_minus1" type="xs:integer" minOccurs="0"/>
      <xs:element name="bit_rate_scale" type="xs:integer" minOccurs="0"/>
      <xs:element name="cpb_size_scale" type="xs:integer" minOccurs="0"/>
      <xs:element name="cpb_size_du_scale" type="xs:integer" minOccurs="0"/>
      <xs:element name="initial_cpb_removal_delay_length_minus1" type="xs:integer" minOccurs="0"/>
      <xs:element name="au_cpb_removal_delay_length_minus1" type="xs:integer" minOccurs="0"/>
      <xs:element name="dpb_output_delay_length_minus1" type="xs:integer" minOccurs="0"/>

      <!-- Sub-layer HRD parameters -->
      <xs:sequence minOccurs="0" maxOccurs="unbounded">
        <xs:element name="fixed_pic_rate_general_flag" type="IndexedBooleanType"/>
        <xs:element name="fixed_pic_rate_within_cvs_flag" type="IndexedBooleanType" minOccurs="0"/>
        <xs:element name="elemental_duration_in_tc_minus1" type="IndexedIntegerType" minOccurs="0"/>
        <xs:element name="low_delay_hrd_flag" type="IndexedBooleanType" minOccurs="0"/>

        <!-- NAL HRD parameters -->
        <xs:element name="nal_cpb_cnt_minus1" type="IndexedIntegerType" minOccurs="0"/>
        <xs:sequence minOccurs="0" maxOccurs="unbounded">
          <xs:element name="nal_bit_rate_value_minus1" type="IndexedIntegerType"/>
          <xs:element name="nal_cpb_size_value_minus1" type="IndexedIntegerType"/>
          <xs:element name="nal_cbr_flag" type="IndexedBooleanType"/>
        </xs:sequence>

        <!-- VCL HRD parameters -->
        <xs:element name="vcl_cpb_cnt_minus1" type="IndexedIntegerType" minOccurs="0"/>
        <xs:sequence minOccurs="0" maxOccurs="unbounded">
          <xs:element name="vcl_bit_rate_value_minus1" type="IndexedIntegerType"/>
          <xs:element name="vcl_cpb_size_value_minus1" type="IndexedIntegerType"/>
          <xs:element name="vcl_cbr_flag" type="IndexedBooleanType"/>
        </xs:sequence>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>

  <!-- InternalVariablesType definition -->
  <xs:complexType name="InternalVariablesType">
    <xs:sequence>
      <xs:any processContents="skip" namespace="##any" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Reusable groups for timing information and HRD parameters -->
  <xs:group name="VpsTimingInfoGroup">
    <xs:sequence>
      <xs:element name="vps_timing_info_present_flag" type="xs:boolean"/>
      <xs:sequence minOccurs="0">
        <xs:element name="vps_num_units_in_tick" type="xs:integer"/>
        <xs:element name="vps_time_scale" type="xs:integer"/>
        <xs:element name="vps_poc_proportional_to_timing_flag" type="xs:boolean"/>
        <xs:element name="vps_num_ticks_poc_diff_one_minus1" type="xs:integer" minOccurs="0"/>
        <xs:element name="vps_num_hrd_parameters" type="xs:integer"/>
        <xs:group ref="HrdParametersGroup"/>
      </xs:sequence>
    </xs:sequence>
  </xs:group>

  <xs:group name="HrdParametersGroup">
    <xs:sequence>
      <xs:element name="hrd_layer_set_idx" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="cprms_present_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="hrd_parameters" type="HRDParametersType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:group>

  <!-- VideoParameterSetType definition -->
  <xs:complexType name="VideoParameterSetType">
    <xs:sequence>
      <!-- Common VPS elements for both single-layer HEVC and MV-HEVC -->
      <xs:element name="vps_video_parameter_set_id" type="xs:integer"/>
      <xs:element name="vps_base_layer_internal_flag" type="xs:boolean"/>
      <xs:element name="vps_base_layer_available_flag" type="xs:boolean"/>
      <xs:element name="vps_max_layers_minus1" type="xs:integer"/>
      <xs:element name="vps_max_sub_layers_minus1" type="xs:integer"/>
      <xs:element name="vps_temporal_id_nesting_flag" type="xs:boolean"/>
      <xs:element name="vps_reserved_0xffff_16bits" type="xs:integer"/>

      <!-- Profile tier level - common for both types -->
      <xs:element name="profile_tier_level" type="ProfileTierLevelType"/>

      <!-- Common elements for both single-layer HEVC and MV-HEVC -->
      <xs:element name="vps_sub_layer_ordering_info_present_flag" type="xs:boolean"/>

      <!-- Sub-layer ordering information (common for both) -->
      <xs:sequence minOccurs="0" maxOccurs="unbounded">
        <xs:element name="vps_max_dec_pic_buffering_minus1" type="IndexedIntegerType" minOccurs="1" maxOccurs="1"/>
        <xs:element name="vps_max_num_reorder_pics" type="IndexedIntegerType" minOccurs="1" maxOccurs="1"/>
        <xs:element name="vps_max_latency_increase_plus1" type="IndexedIntegerType" minOccurs="1" maxOccurs="1"/>
      </xs:sequence>
      <xs:element name="vps_max_layer_id" type="xs:integer"/>
      <xs:element name="vps_num_layer_sets_minus1" type="xs:integer"/>

      <!-- Layer dependency flags -->
      <xs:element name="layer_dependency_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>

      <!-- Layer ID included flags -->
      <xs:element name="layer_id_included_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="unbounded"/>
      
      <!-- VPS timing information and HRD parameters -->
      <xs:group ref="VpsTimingInfoGroup"/>

      <xs:element name="vps_extension_flag" type="xs:boolean"/>

      <!-- Choice between single-layer HEVC and MV-HEVC specific structures -->
      <xs:choice>
        <!-- Single-layer HEVC VPS structure (vps_max_layers_minus1 = 0) -->
        <xs:sequence>
          <!-- VPS extension -->
          <xs:element name="vps_extension_data_byte" type="xs:integer" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>

        <!-- MV-HEVC VPS structure (vps_max_layers_minus1 > 0) -->
        <xs:sequence>
          <!-- Additional profile tier levels immediately after VPS extension -->
          <xs:element name="profile_tier_level" type="ProfileTierLevelType" minOccurs="0" maxOccurs="unbounded"/>

          <!-- Additional MV-HEVC elements after profile tier levels -->
          <xs:element name="splitting_flag" type="xs:boolean"/>
          <xs:element name="scalability_mask_flag" type="IndexedBooleanType" minOccurs="0" maxOccurs="16"/>
          <xs:element name="dimension_id_len_minus1" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="vps_nuh_layer_id_present_flag" type="xs:boolean"/>
          <xs:element name="layer_id_in_nuh" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="dimension_id" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="view_id_len" type="xs:integer" minOccurs="0"/>
          <xs:element name="view_id_val" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="direct_dependency_flag" type="IndexedIntegerType" minOccurs="0" maxOccurs="unbounded"/>
          <xs:element name="num_add_layer_sets">
            <xs:complexType>
              <xs:simpleContent>
                <xs:extension base="xs:integer">
                  <xs:attribute name="inferred" type="xs:boolean" use="optional"/>
                </xs:extension>
              </xs:simpleContent>
            </xs:complexType>
